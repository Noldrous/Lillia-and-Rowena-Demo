{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["public/assets/js/**/*.js", "server.js"],
  "exclude": ["dist", "node_modules"]
}
